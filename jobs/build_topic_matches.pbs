#!/bin/bash
#PBS -N defence-topicmatch-full
#PBS -l walltime=01:30:00
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -q cse12
#PBS -j oe

set -euo pipefail
REPO=/home/z5703460/defence-language-classifier
SCRATCH=/srv/scratch/z5703460
VENV="$SCRATCH/venvs/defence-language-classifier"

module purge
module load python/3.11.3
export HF_HOME="$SCRATCH/cache/huggingface"
export HF_HUB_CACHE="$HF_HOME/hub"
export TOKENIZERS_PARALLELISM=true

cd "$REPO"
"$VENV/bin/python" scripts/build_topic_matched_negatives.py \
  --defence data/processed/defence_passages.jsonl \
  --dataset-splits data/processed/dataset_splits.jsonl \
  --negatives-output data/processed/topic_matched_wikipedia_negatives.jsonl \
  --pairs-output data/processed/topic_matched_pairs.jsonl \
  --combined-output data/processed/topic_matched_dataset_splits.jsonl \
  --manifest-output data/processed/topic_matched_split_manifest.json \
  --report-dir reports/topic_matched \
  --cache-dir "$SCRATCH/cache/topic_matching" \
  --workers 10 \
  --max-extract-words 900
