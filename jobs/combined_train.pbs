#!/bin/bash
#PBS -N defence-combtrain
#PBS -l walltime=00:45:00
#PBS -j oe

set -euo pipefail
REPO=/home/z5703460/defence-language-classifier
SCRATCH=/srv/scratch/z5703460
VENV="$SCRATCH/venvs/defence-language-classifier"
: "${STAGE:?Submit with STAGE=minilm or qwen}"

module purge
module load python/3.11.3
export HF_HOME="$SCRATCH/cache/huggingface"
export HF_HUB_CACHE="$HF_HOME/hub"
export TOKENIZERS_PARALLELISM=true

cd "$REPO"
case "$STAGE" in
    minilm)
        "$VENV/bin/python" scripts/train_baselines.py \
            --dataset data/processed/combined_dataset_splits.jsonl \
            --model-dir models/combined_minilm \
            --report-dir reports/combined_minilm \
            --cache-dir "$SCRATCH/defence-language-classifier/embeddings/combined-minilm" \
            --sbert-checkpoint sentence-transformers/all-MiniLM-L6-v2 \
            --batch-size 32
        ;;
    qwen)
        "$VENV/bin/python" scripts/train_baselines.py \
            --dataset data/processed/combined_dataset_splits.jsonl \
            --model-dir models/combined_qwen \
            --report-dir reports/combined_qwen \
            --cache-dir "$SCRATCH/defence-language-classifier/embeddings/combined-qwen3-embedding-8b" \
            --sbert-checkpoint Qwen/Qwen3-Embedding-8B \
            --batch-size 4
        ;;
    *)
        echo "Unknown STAGE=$STAGE" >&2
        exit 2
        ;;
esac
