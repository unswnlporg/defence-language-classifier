#!/bin/bash
#PBS -N pref-transfer-gpu
#PBS -l walltime=00:30:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_model=A100
#PBS -q csegpu12
#PBS -j oe

set -euo pipefail
REPO=/home/z5703460/defence-language-classifier
SCRATCH=/srv/scratch/z5703460
VENV="$SCRATCH/venvs/defence-language-classifier"

module purge
module load python/3.11.3
export HF_HOME="$SCRATCH/cache/huggingface"
export HF_HUB_CACHE="$HF_HOME/hub"
export TOKENIZERS_PARALLELISM=true

cd "$REPO"

"$VENV/bin/python" scripts/evaluate_preference_transfer.py \
  --model-dir models/qwen --model-type sbert \
  --scores-output reports/preference_transfer/easy_qwen_scores.jsonl \
  --summary-output reports/preference_transfer/easy_qwen_summary.json \
  --samples-output reports/preference_transfer/easy_qwen_samples.json \
  --batch-size 4
