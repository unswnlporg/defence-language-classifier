#!/bin/bash
#PBS -N pref-cross-eval-cpu
#PBS -l walltime=00:30:00
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -q cse12
#PBS -j oe

set -euo pipefail
REPO=/home/z5703460/defence-language-classifier
SCRATCH=/srv/scratch/z5703460
VENV="$SCRATCH/venvs/defence-language-classifier"

module purge
module load python/3.11.3
export HF_HOME="$SCRATCH/cache/huggingface"
export HF_HUB_CACHE="$HF_HOME/hub"
export TOKENIZERS_PARALLELISM=true

cd "$REPO"
EASY=data/processed/dataset_splits.jsonl
TOPIC=data/processed/hybrid_topic_dataset_splits.jsonl

"$VENV/bin/python" scripts/cross_evaluate.py --model-dir models/preference_qwen --model-type tfidf --target-dataset "$EASY"  --output reports/cross_eval/pref_tfidf_on_easy.json
"$VENV/bin/python" scripts/cross_evaluate.py --model-dir models/preference_qwen --model-type tfidf --target-dataset "$TOPIC" --output reports/cross_eval/pref_tfidf_on_topic.json
"$VENV/bin/python" scripts/cross_evaluate.py --model-dir models/preference_minilm --model-type sbert --target-dataset "$EASY"  --output reports/cross_eval/pref_minilm_on_easy.json
"$VENV/bin/python" scripts/cross_evaluate.py --model-dir models/preference_minilm --model-type sbert --target-dataset "$TOPIC" --output reports/cross_eval/pref_minilm_on_topic.json
