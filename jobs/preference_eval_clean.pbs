#!/bin/bash
#PBS -N pref-qwen-eval
#PBS -l walltime=00:30:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_model=A100
#PBS -q csegpu12
#PBS -j oe

set -euo pipefail
REPO=/home/z5703460/defence-language-classifier
SCRATCH=/srv/scratch/z5703460
VENV="$SCRATCH/venvs/defence-language-classifier"

module purge
module load python/3.11.3
export HF_HOME="$SCRATCH/cache/huggingface"
export HF_HUB_CACHE="$HF_HOME/hub"
export TOKENIZERS_PARALLELISM=true

cd "$REPO"
"$VENV/bin/python" scripts/score_preference_pairs.py \
  --pairs data/raw/preference_pairs_clean141.jsonl \
  --model-dir models/preference_qwen \
  --output reports/preference_qwen/eval_clean141_scores.jsonl \
  --summary reports/preference_qwen/eval_clean141_summary.json \
  --batch-size 4
